# Backup di un'applicazione (istanza: app-backup@<nome>.service). Avviato dal timer omonimo.
[Unit]
Description=Backup applicazione %i (appctl backup)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Environment=APPCTL_ACTOR=systemd-backup
ExecStart=/usr/local/bin/appctl --app %i backup
Nice=10
IOSchedulingClass=idle
