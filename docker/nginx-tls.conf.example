# Production Nginx configuration for SCARLET with TLS.
# Copy to nginx-tls.conf, mount your certificate/key (internal CA or Let's Encrypt) at the paths below.
# No certificates are shipped with SCARLET.
worker_processes auto;
events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;
    client_max_body_size 2100m;
    client_body_timeout 600s;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_http_version 1.1;
    proxy_request_buffering off;

    log_format scarlet '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
                       '"$http_referer" "$http_user_agent" rid=$upstream_http_x_request_id rt=$request_time';
    access_log /var/log/nginx/access.log scarlet;

    upstream scarlet_web { server scarlet-web:8000; keepalive 16; }

    # Redirect plain HTTP to HTTPS (SCARLET must never be served over HTTP in production).
    server {
        listen 80;
        server_name scarlet.example.internal;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name scarlet.example.internal;

        ssl_certificate     /etc/nginx/tls/scarlet.crt;      # full chain (server + intermediate CA)
        ssl_certificate_key /etc/nginx/tls/scarlet.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;
        # ssl_stapling on; ssl_stapling_verify on;  # enable when the CA supports OCSP

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        location / {
            proxy_pass http://scarlet_web;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Connection "";
        }
    }
}
