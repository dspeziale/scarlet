# Configurazione NON sensibile dell'applicazione per l'ambiente DEVELOPMENT.
# Copiata sul server in /opt/apps/scarlet/config/app.env dall'installazione.
# Le modifiche successive si fanno sul server (o qui, con un nuovo deploy: il file
# di riferimento e' questo). MAI inserire password o token: vanno in secrets/app.secrets.env.
SCARLET_ENVIRONMENT=development
SCARLET_LOG_LEVEL=DEBUG
SCARLET_LOG_FORMAT=json
SCARLET_WORKERS=1
