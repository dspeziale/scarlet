# Configurazione NON sensibile dell'applicazione per l'ambiente PRODUCTION.
# Copiata sul server in /opt/apps/scarlet/config/app.env dall'installazione.
# MAI inserire password o token: vanno in secrets/app.secrets.env.
SCARLET_ENVIRONMENT=production
SCARLET_LOG_LEVEL=INFO
SCARLET_LOG_FORMAT=json
SCARLET_WORKERS=2
