# Podman Kubernetes Manager - environment overrides (installed as /etc/pkm/pkm.env, mode 0640 root:pkm)
# Format: PKM_<SECTION>__<KEY>=value. Environment values override /etc/pkm/config.yaml.
# Never commit real values: this file is an example.

# Configuration file location (default /etc/pkm/config.yaml)
PKM_CONFIG=/etc/pkm/config.yaml

# Server
# PKM_SERVER__HOST=0.0.0.0
# PKM_SERVER__PORT=8443
# PKM_SERVER__TLS_CERT=/etc/pkm/tls/pkm.crt
# PKM_SERVER__TLS_KEY=/etc/pkm/tls/pkm.key

# Kubernetes
# PKM_KUBERNETES__KUBECONFIG=/etc/pkm/kubeconfig
# PKM_KUBERNETES__CONTEXT=

# Podman
# PKM_PODMAN__URL=unix:///run/podman/podman.sock

# Prometheus bearer token (secret: keep it here, not in config.yaml)
# PKM_MONITORING__PROMETHEUS_TOKEN=

# Logging
# PKM_LOGGING__LEVEL=INFO

# Development only (refused with environment=production):
# PKM_MODE=demo
# PKM_ENVIRONMENT=development
