# ESEMPIO di file secrets. Sul server il file reale e' /opt/apps/scarlet/secrets/app.secrets.env
# con permessi 0600 e owner deploy. NON versionare mai il file reale.
#
# Generare valori casuali, ad esempio:  openssl rand -hex 24
#
# --- PostgreSQL containerizzato (compose.db.yaml)
POSTGRES_USER=scarlet
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=scarlet

# --- Applicazione
# Con DB containerizzato l'host e' "db" (nome del servizio compose). Con DB esterno: host reale.
SCARLET_DATABASE_URL=postgresql+psycopg://scarlet:CHANGE_ME@db:5432/scarlet
# Token richiesto per POST /api/deployments (header X-API-Key).
SCARLET_API_TOKEN=CHANGE_ME
