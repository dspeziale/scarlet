# ============================================================================
# SCARLET configuration (copy to .env and adjust). Never commit .env.
# ============================================================================

# development | production | testing
SCARLET_ENV=development
SCARLET_DEBUG=false
SCARLET_LOG_LEVEL=INFO
# json | text
SCARLET_LOG_FORMAT=json

# --- secrets (REQUIRED in production; generate with: flask scarlet gen-key) ---
SCARLET_SECRET_KEY=
SCARLET_CREDENTIAL_ENCRYPTION_KEY=
# set only during key rotation, then run `flask scarlet rotate-credentials`
SCARLET_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# --- database / queue ---
DATABASE_URL=postgresql://scarlet:scarlet@postgres:5432/scarlet
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND default to REDIS_URL
POSTGRES_PASSWORD=scarlet

# --- storage ---
SCARLET_ARTIFACT_PATH=/data/scarlet/artifacts
SCARLET_UPLOAD_TMP_PATH=/data/scarlet/uploads
SCARLET_LOG_PATH=/data/scarlet/logs
SCARLET_MAX_UPLOAD_MB=2048

# --- remote hosts ---
SCARLET_REMOTE_BASE_PATH=/opt/scarlet
SCARLET_SSH_TIMEOUT=30
SCARLET_SSH_COMMAND_TIMEOUT=600
# strict (mandatory in production) | tofu (trust on first use, development only)
SCARLET_SSH_HOST_KEY_POLICY=strict

# --- jobs ---
SCARLET_JOB_TIMEOUT=3600
SCARLET_DEPLOYMENT_TIMEOUT=1800
SCARLET_HEALTH_CHECK_TIMEOUT=10
SCARLET_HEALTH_CHECK_RETRIES=5
SCARLET_LOCK_TIMEOUT=1800
SCARLET_MAX_PARALLEL_DEPLOYMENTS=3
SCARLET_PROD_MAX_PARALLEL_DEPLOYMENTS=1
SCARLET_RECONCILE_ENABLED=true
SCARLET_RECONCILE_INTERVAL=300
SCARLET_RECONCILE_AUTO_REMEDIATE=false

# --- production safety ---
SCARLET_PROD_REQUIRE_CONFIRMATION=true
SCARLET_PROD_CONFIRMATION_PHRASE=DEPLOY TO PROD
SCARLET_PROD_REQUIRE_REASON=true
SCARLET_PROD_REQUIRE_APPROVAL=false
SCARLET_PROD_ALLOW_ROLLBACK=true
SCARLET_AUTO_ROLLBACK=false

# --- retention ---
SCARLET_ARTIFACT_RETENTION_COUNT=10
SCARLET_LOG_RETENTION_DAYS=90
SCARLET_OPERATION_LOG_RETENTION_DAYS=180
# 0 = never purge audit records
SCARLET_AUDIT_RETENTION_DAYS=0

# --- web security ---
SESSION_COOKIE_SECURE=true
SCARLET_SESSION_LIFETIME_SECONDS=28800
SCARLET_LOGIN_RATE_LIMIT=5 per minute
SCARLET_API_RATE_LIMIT=600 per minute
SCARLET_HSTS_ENABLED=true
# number of trusted reverse proxies in front of gunicorn (nginx = 1)
SCARLET_TRUSTED_PROXIES=1
# cdn | local (see docs/installation.md for vendoring assets offline)
SCARLET_ASSET_MODE=cdn
SCARLET_API_DOCS_ENABLED=false

# --- password policy ---
SCARLET_PASSWORD_MIN_LENGTH=12
SCARLET_PASSWORD_REQUIRE_COMPLEXITY=true
SCARLET_MAX_FAILED_LOGINS=10
SCARLET_LOCKOUT_MINUTES=15

# --- initial admin (used once by `flask scarlet seed`; remove afterwards) ---
SCARLET_INITIAL_ADMIN_PASSWORD=

# --- e-mail notifications (disabled unless configured) ---
SCARLET_MAIL_ENABLED=false
SCARLET_MAIL_SERVER=
SCARLET_MAIL_PORT=587
SCARLET_MAIL_USE_TLS=true
SCARLET_MAIL_USERNAME=
SCARLET_MAIL_PASSWORD=
SCARLET_MAIL_FROM=scarlet@example.internal

# --- optional malware scanner, {path} is replaced with the uploaded file ---
SCARLET_MALWARE_SCANNER_COMMAND=
# e.g. SCARLET_MALWARE_SCANNER_COMMAND=clamscan --no-summary {path}

# --- gunicorn ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# --- development compose stack (docker-compose.yml) ---
# host port published by nginx (change if 8080 is taken)
SCARLET_HTTP_PORT=8080
# simulated Oracle Linux target (profile "dev"): SSH port and password of user "scarlet"
MOCKHOST_SSH_PORT=2222
MOCKHOST_PASSWORD=scarlet-dev
# sudo = Podman via sudo wrapper (works inside Docker Desktop); rootless = native rootless Podman
MOCKHOST_PODMAN_MODE=sudo
