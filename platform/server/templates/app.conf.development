# Manifest applicazione (server DEVELOPMENT). Letto da appctl. Formato KEY=VALUE.
# Generato da install-app.sh; modificabile a mano (poi: appctl doctor).

# --- identita'
APP_NAME=@APP_NAME@
APP_ENVIRONMENT=development
IMAGE_REPOSITORY=@IMAGE_REPOSITORY@

# --- compose (file relativi al bundle /deploy dell'immagine, separati da ':')
# Con DB esterno: togliere compose.db.yaml e impostare DB_SERVICE vuoto.
COMPOSE_FILES=compose.yaml:compose.db.yaml:compose.dev.yaml
APP_SERVICE=app
DB_SERVICE=db

# --- rete e health (porta locale 127.0.0.1 usata da operatori/appctl; l'esterno passa dal proxy)
APP_PORT=@APP_PORT@
HEALTH_TIMEOUT=120
HEALTH_INTERVAL=3
# URL pubblico (solo per il controllo del certificato in appctl doctor)
PUBLIC_URL=

# --- deploy
MIGRATE_COMMAND=alembic upgrade head
AUTO_ROLLBACK=true
KEEP_RELEASES=5
PULL_POLICY=always
BACKUP_BEFORE_MIGRATE=false

# --- backup
BACKUP_KEEP_DAYS=7
